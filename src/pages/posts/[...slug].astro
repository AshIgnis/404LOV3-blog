---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { formatDate, readingTime } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post" data-pagefind-body>
    <header><p class="eyebrow">{post.data.tags.map((tag) => `#${tag}`).join(' · ')}</p><h1>{post.data.title}</h1><p class="summary">{post.data.description}</p><div class="meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>·</span><span>{readingTime(post.body)}</span>{post.data.updatedDate && <><span>·</span><span>更新于 {formatDate(post.data.updatedDate)}</span></>}</div></header>
    <div class="prose"><Content /></div>
  </article>
  <Comments />
</BaseLayout>
<style>
  .post { max-width: 760px; margin: 0 auto; padding-top: 68px; } header { padding-bottom: 43px; border-bottom: 1px solid var(--line); } h1 { margin: 8px 0 14px; font-size: clamp(2.2rem,5.5vw,4rem); font-weight: 500; letter-spacing: .07em; line-height: 1.3; } .summary { margin: 0; color: var(--muted); font-size: 1.05rem; } .meta { display:flex; flex-wrap:wrap; gap:.45rem; margin-top:20px; color:var(--muted); font-family:ui-sans-serif,system-ui,sans-serif; font-size:.75rem; } .prose { padding-top: 42px; font-size: 1.06rem; line-height: 2; } :global(.prose h2){margin:2.4em 0 .7em;font-size:1.55em;font-weight:500;letter-spacing:.05em;} :global(.prose h3){margin:2em 0 .5em;font-size:1.25em;font-weight:500;} :global(.prose p){margin:1.35em 0;} :global(.prose a){color:var(--accent);border-bottom:1px solid currentColor;} :global(.prose blockquote){margin:1.8em 0;padding:.3em 1.3em;color:var(--muted);border-left:2px solid var(--accent);background:var(--paper-deep);} :global(.prose pre){overflow:auto;padding:1.2rem;background:#30372f;color:#f7f0e6;border-radius:2px;font-size:.85rem;line-height:1.7;} :global(.prose img){max-width:100%;height:auto;} :global(.prose :not(pre)>code){padding:.1em .35em;background:var(--paper-deep);font-size:.9em;} @media(max-width:700px){.post{padding-top:48px}.prose{padding-top:30px;font-size:1rem;}}
</style>
