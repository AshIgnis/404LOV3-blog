---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="搜索">
  <section class="search-page">
    <p class="eyebrow">翻找记忆</p><h1>搜索文章</h1>
    <div id="search"></div>
  </section>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>window.addEventListener('DOMContentLoaded', () => new PagefindUI({ element: '#search', showSubResults: true, resetStyles: false, translations: { placeholder: '搜索标题、标签或正文', clear_search: '清除', load_more: '加载更多结果', search_label: '搜索本站', filters_label: '筛选' } }));</script>
</BaseLayout>
<style>
  .search-page { min-height: 540px; padding: 60px 0; } h1 { margin: 4px 0 38px; font-size: clamp(2.1rem, 5vw, 3.4rem); font-weight: 500; letter-spacing: .08em; } :global(.pagefind-ui) { font-family: inherit; } :global(.pagefind-ui__search-input) { padding: 14px 16px; color: var(--ink); border: 1px solid var(--line); border-radius: 0; background: var(--paper); } :global(.pagefind-ui__result) { padding: 20px 0; border-color: var(--line); } :global(.pagefind-ui__result-link) { color: var(--ink); font-family: inherit; font-size: 1.2rem; } :global(.pagefind-ui__result-excerpt) { color: var(--muted); }
</style>
